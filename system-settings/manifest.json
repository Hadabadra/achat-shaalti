{
  "id": "com.chadbedera.systemsettings",
  "name": "הגדרות מערכת",
  "version": "3.5.0",
  "description": "כל הגדרות המחשב מתוך אוצריא: מסך, שמע, חשמל, שעה, מקלדת, עכבר, מדפסות, USB, רשת, ומצב נעילה ללימוד. דורש את תוכנת חסימת אוצריא.",
  "author": "גמח תורת אסתר",
  "homepage": "https://github.com/e0548433917-gif/otzaria-system-tools",
  "schemaVersion": 1,
  "sdkVersion": "1.x",
  "stability": "stable",
  "minAppVersion": "0.9.98",
  "entrypoint": "index.html",
  "icon": "icon/icon.png",
  "permissions": [
    "network.localhost",
    "app.open_url",
    "calendar.read"
  ],
  "network": {
    "enabled": true,
    "allowlist": [
      "127.0.0.1",
      "localhost"
    ]
  },
  "contributes": {
    "toolTab": {
      "title": "הגדרות מערכת",
      "order": 920,
      "allowOrderBeforeBuiltIns": true,
      "defaultPinned": false,
      "iconName": "settings_24_regular"
    }
  }
}
