<Project Sdk="Microsoft.NET.Sdk">

  <!--
    בדיקות יחידה ללוגיקה טהורה וקלה-לשבירה: חלון התזמון (Sched), השוואת גרסאות
    העדכון (UpdateApi.Parse), ונורמליזציית קוד שחזור (Secret.NormalizeRecovery).
    לא בודק רשת/רישום/תהליכים — זה נשאר לבדיקת-שטח ידנית על Windows אמיתי.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1416;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\bridge\OtzariaBridge.csproj" />
  </ItemGroup>

</Project>
