{
  "id": "com.chadbedera.fileexplorer",
  "name": "סייר קבצים",
  "version": "3.4.0",
  "description": "סייר קבצים מתוך אוצריא: עיון, העתקה, גזירה, הדבקה, מחיקה, שינוי שם, תצוגה מקדימה וחיפוש קבצים. דורש את תוכנת חסימת אוצריא; בלעדיו עובד על תיקיות שאושרו.",
  "author": "גמח תורת אסתר",
  "schemaVersion": 1,
  "sdkVersion": "1.x",
  "stability": "stable",
  "minAppVersion": "0.9.98",
  "entrypoint": "index.html",
  "icon": "icon/icon.png",
  "permissions": [
    "network.localhost",
    "app.open_url",
    "fs.user_files.read",
    "fs.user_files.write",
    "reader.toolbar",
    "app.startup_contributions",
    "navigation.write",
    "plugin.open_other",
    "events.subscribe:settings.changed",
    "events.subscribe:plugin.permissions_changed",
    "app.info.read",
    "notifications.system",
    "notifications.send",
    "app.shortcuts",
    "clipboard.read",
    "fonts.local.read",
    "library.books.provide"
  ],
  "network": {
    "enabled": true,
    "allowlist": [
      "127.0.0.1",
      "localhost"
    ]
  },
  "contributes": {
    "toolTab": {
      "title": "סייר קבצים",
      "order": 910,
      "allowOrderBeforeBuiltIns": true,
      "defaultPinned": false,
      "iconName": "folder_24_regular"
    },
    "startup": {
      "toolbarItems": [
        {
          "id": "chadbedera-fx-new-doc",
          "type": "button",
          "title": "מסמך חדש",
          "icon": "add_24_regular",
          "openPlugin": true
        }
      ]
    }
  },
  "homepage": "https://github.com/e0548433917-gif/otzaria-system-tools"
}
