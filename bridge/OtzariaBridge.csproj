<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>OtzariaBridge</AssemblyName>
    <RootNamespace>OtzariaBridge</RootNamespace>
    <Version>3.5.0</Version>
    <Product>תוכנת חסימת אוצריא</Product>
    <AssemblyTitle>תוכנת חסימת אוצריא - גמח תורת אסתר</AssemblyTitle>
    <Company>גמח תורת אסתר</Company>
    <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <!-- חישוב זמני היום בגיבוי (bridge/Zmanim.cs): פורט ה-.NET הרשמי של פרויקט KosherJava
         מאת Eliyahu Hershfeld (kosherjava.com), רישיון LGPL-2.1. PackageReference רגיל
         (קישור דינמי, לא קוד מועתק) — ראו README.md וחלון "אודות" לקרדיט המלא -->
    <PackageReference Include="Zmanim" Version="1.5.0" />
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
  </ItemGroup>

  <!-- התוספים נארזים ב-CI לתיקייה plugins ומוטמעים כמשאב -->
  <ItemGroup>
    <EmbeddedResource Include="plugins\*.otzplugin" LogicalName="plugins.%(Filename)%(Extension)" />
    <!-- יומן השינויים מוטמע, כדי שיהיה זמין במגש בלי רשת -->
    <EmbeddedResource Include="..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
  </ItemGroup>

  <!-- חושף internal (למשל Kiosk.NormalizeRecovery) לפרויקט הבדיקות בלבד -->
  <ItemGroup>
    <InternalsVisibleTo Include="OtzariaBridge.Tests" />
  </ItemGroup>

  <!-- חושף חברי internal (אם יתווספו) לפרויקט הבדיקות בלבד -->
  <ItemGroup>
    <InternalsVisibleTo Include="OtzariaBridge.Tests" />
  </ItemGroup>

</Project>
